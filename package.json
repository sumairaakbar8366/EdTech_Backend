{
  "name": "schoolerp",
  "version": "0.1.0",
  "private": true,
  "description": "SchoolERP: multi-tenant school management SaaS",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @schoolerp/shared && npm run build -w @schoolerp/api && npm run build -w @schoolerp/web",
    "build:shared": "npm run build -w @schoolerp/shared",
    "dev:api": "npm run start:dev -w @schoolerp/api",
    "dev:web": "npm run dev -w @schoolerp/web",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @schoolerp/api",
    "db:seed": "npm run db:seed -w @schoolerp/api",
    "test": "npm run test -w @schoolerp/shared && npm run test -w @schoolerp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "argon2@0.45.1": true
  }
}

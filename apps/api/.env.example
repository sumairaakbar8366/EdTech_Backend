# Copy to .env and adjust. Values below match docker-compose.yml (local dev only).

NODE_ENV=development
PORT=3000

# Runtime connection: the non-superuser app role, so Postgres row-level security applies.
DATABASE_URL=postgresql://schoolerp_app:schoolerp_app@localhost:5432/schoolerp
# Migration connection: the schema owner. Used only by the Prisma CLI.
MIGRATION_DATABASE_URL=postgresql://schoolerp:schoolerp@localhost:5432/schoolerp

REDIS_URL=redis://localhost:6379

# Tenant routing. Schools live at <slug>.<BASE_DOMAIN>; the platform console at PLATFORM_HOST.
BASE_DOMAIN=localhost
PLATFORM_HOST=admin.localhost
# Set to true only when running behind a trusted reverse proxy that sets X-Forwarded-Host.
TRUST_PROXY=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Uploaded documents (local disk in development; swap the storage driver for S3/R2 in production).
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Used by `npm run db:seed` to create the first platform admin and a demo school.
SEED_PLATFORM_ADMIN_EMAIL=owner@schoolerp.local
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe!2026
SEED_DEMO_SCHOOL=true

# Background jobs (BullMQ on REDIS_URL). Turned off automatically for CLI scripts.
JOBS_ENABLED=true

# Outbound delivery. "outbox" writes each message to STORAGE_DIR/outbox (nothing leaves the machine).
# For real email set EMAIL_DRIVER=smtp and the SMTP_* values (any provider: Gmail/Workspace, Brevo, SES, Mailgun…).
EMAIL_DRIVER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SchoolERP <no-reply@schoolerp.local>
SMS_DRIVER=outbox
WHATSAPP_DRIVER=outbox
PUSH_DRIVER=outbox

# Links in emails: <scheme>://<school>.<BASE_DOMAIN>[:<port>] (port 5173 = Vite dev server).
WEB_URL_SCHEME=http
WEB_URL_PORT=5173

# SMS: "twilio" sends real SMS. WhatsApp: "cloud" = Meta WhatsApp Business Cloud API.
# Schools choose Off / SMS / WhatsApp in Settings; email is always sent.
SMS_DRIVER=outbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_DRIVER=outbox
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with one {{1}} body parameter (needed outside a 24-hour chat window).
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Web push: generate keys with `npx web-push generate-vapid-keys`, then PUSH_DRIVER=webpush.
PUSH_DRIVER=outbox
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Online payments: the built-in test gateway; set a long random secret in production.
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=
